# VeVit Account — monorepo (Apache, subdirectory /account/)

RewriteEngine On
# HTTPS redirect handled at Nginx/vhost level in monorepo

DirectoryIndex index.php

# Keep public login URLs clean and run account entry requests through PHP.
RewriteRule ^login/?$ login.html [L]
RewriteRule ^onboarding/?$ onboarding.php [L]
# V monorepu tento .htaccess leží pod /account/ — Apache předává URL bez prefixu /account/
# Proto ^account(/.*)?$ → stačí ^(/.*)?$ nebo prázdné pravidlo.
RewriteRule ^(/.*)?$ index.php [L,QSA]
RewriteRule ^$ index.php [L]
RewriteRule ^index\.html$ index.php [L]

# Protect secrets and source
<FilesMatch "^config\.php$|^config\.example\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>

# Protect library files from direct HTTP requests. PHP includes still work.
RewriteRule ^lib/ - [F,L]
RewriteRule ^vendor/ - [F,L]

# Static caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
