{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["fra1"],
  "functions": {
    "src/app/**/route.ts": {
      "maxDuration": 30
    },
    "src/app/tools/api/ai/[tool]/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [{ "path": "/api/jobs/run", "schedule": "0 4 * * *" }]
}
