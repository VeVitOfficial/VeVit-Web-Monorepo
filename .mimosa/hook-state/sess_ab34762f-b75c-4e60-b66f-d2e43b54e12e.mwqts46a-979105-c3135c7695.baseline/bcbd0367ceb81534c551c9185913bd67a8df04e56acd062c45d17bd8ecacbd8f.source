<?php
// VeVit Edu API — Database config & shared helpers
// MariaDB 10.4 on md396.wedos.net:3306

define('CERT_SECRET', 'vevit-certs-2025');

// Security headers
header('X-Content-Type-Options: nosniff');
header('X-Frame-Options: SAMEORIGIN');
header('X-XSS-Protection: 1; mode=block');
header('Referrer-Policy: strict-origin-when-cross-origin');
header('Content-Type: application/json; charset=utf-8');

// CORS — monorepo: vevit.cz (původně *.vevit.fun)
$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
$allowedOrigins = ['https://vevit.cz', 'https://www.vevit.cz', 'http://localhost:5500', 'http://localhost:8080'];
if (in_array($origin, $allowedOrigins, true)) {
    header("Access-Control-Allow-Origin: $origin");
    header('Access-Control-Allow-Credentials: true');
    header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
    header('Access-Control-Allow-Headers: Content-Type');
}
if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(204);
    exit;
}

// Database connection (edu DB — courses, lessons, quizzes, user_progress)
function db() {
    static $pdo = null;
    if ($pdo !== null) return $pdo;
    try {
        $pdo = new PDO(
            'mysql:host=md396.wedos.net;port=3306;dbname=d390994_edu;charset=utf8',
            'd390994_edu',
            'CHANGE_ME_STRONG_PASSWORD',
            [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                PDO::ATTR_EMULATE_PREPARES => false,
            ]
        );
        return $pdo;
    } catch (PDOException $e) {
        error_log('DB connect error: ' . $e->getMessage());
        chyba('Databáze nedostupná', 503);
    }
}

// Account DB (users table — id, nickname, email, xp, level, role)
function dbAccount() {
    static $pdo = null;
    if ($pdo !== null) return $pdo;
    try {
        $pdo = new PDO(
            'mysql:host=md396.wedos.net;port=3306;dbname=d390994_account;charset=utf8',
            'd390994_account',
            'CHANGE_ME_STRONG_PASSWORD',
            [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                PDO::ATTR_EMULATE_PREPARES => false,
            ]
        );
        return $pdo;
    } catch (PDOException $e) {
        error_log('Account DB connect error: ' . $e->getMessage());
        chyba('Databáze účtů nedostupná', 503);
    }
}

// JSON success response
function odpoved($data, $status = 200) {
    http_response_code($status);
    echo json_encode(['ok' => true, 'data' => $data], JSON_UNESCAPED_UNICODE);
    exit;
}

// JSON error response
function chyba($zprava, $status = 400) {
    http_response_code($status);
    echo json_encode(['ok' => false, 'error' => $zprava], JSON_UNESCAPED_UNICODE);
    exit;
}

// Sanitize output
function esc($str) {
    return htmlspecialchars($str, ENT_QUOTES, 'UTF-8');
}