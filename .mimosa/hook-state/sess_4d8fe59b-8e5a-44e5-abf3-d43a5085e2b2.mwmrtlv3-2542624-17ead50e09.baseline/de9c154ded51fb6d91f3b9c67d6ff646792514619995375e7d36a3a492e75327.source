import type { Category } from "@/components/tools/registry/data";

// Barevná paleta kategorií z redesignu EveryTool.cz (index.html) — další
// vizuální vrstva nad registry/data.ts. Registry CATEGORY_COLORS (z --vv-*
// tokenů) zůstávají platné pro stránky jednotlivých nástrojů; hub a hlavička
// nového designu používají tyto barvy (dlaždice, tečky, ikony, tóny karet).
export const ET_CATEGORY_COLORS: Record<Category, string> = {
  pdf: "#E5383B",
  image: "#7B3FF2",
  media: "#D42A80",
  text: "#B27600",
  ai: "#2F6BFF",
  dev: "#0B8A7B",
  security: "#188A4A",
  calc: "#DA5A0F",
};

/** Kategorie zobrazené v hlavičce (zbylé řeší dlaždice na hubu). */
export const ET_NAV_CATEGORIES: readonly Category[] = ["pdf", "image", "media", "text", "ai"];
