{"nodes": [{"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_same_origin_sso_plan", "label": "VEVIT same-origin SSO implementation plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_central_opaque_session", "label": "Central opaque Supabase session", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Account is the single issuer; a shared server-side PHP layer verifies the token hash, absolute expiration, account status, roles and CSRF; frontends consume only /account/api/me.php and never read the cookie client-side."}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_shared_auth_layer", "label": "Shared server PHP auth layer", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test-first public PHP interface distinguishing 401 from 503, absolute expiration, soft revoke, a Bearer feature flag, CSRF and fresh auth, so every frontend shares one verification path instead of parallel issuers."}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_xss_regression_gate", "label": "Shared XSS regression gate", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A test that first fails on known payloads for Wikipedia, markdown, Store and both Edu implementations, plus a static ban on inline scripts, inline handlers, new Function, external scripts and a root frontend /api/; run before and after every related change so sanitization can never silently regress."}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_fail_closed_markdown_renderer", "label": "Fail-closed markdown renderer (plan task)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The editor and all AI outputs render through one fail-closed renderer so a missing sanitizer dependency can never mean unsanitized HTML; the HTML-to-PDF test is extended with mutation-XSS payloads."}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_edu_sanitization", "label": "Edu DOMPurify allowlist and Wikipedia sanitization", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendorized DOMPurify behind one narrow unified allowlist; /edu/api/wikipedia.php uses a fixed upstream, timeout, limit and server-side sanitization, and the client re-sanitizes and renders in an opaque iframe; legacy lesson.content is sanitized while the structured renderer stays."}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_sandbox_protocol", "label": "Unified playground sandbox protocol", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both Edu playgrounds are replaced by one sandbox protocol with source checking, null-origin, nonce, schema checks and guaranteed cleanup, so untrusted code cannot reach the parent origin."}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_csp_hardening", "label": "Strict script CSP prerequisites and report-only rollout", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pin and locally serve Lucide, KaTeX, Prism and fonts, replace the Tailwind Play CDN with statically built CSS and move inline scripts to external files, so a report-only script-src 'self' policy (with a temporary inline-style concession) reports zero violations before enforcement; headers are repeated in nested Nginx locations so inheritance cannot drop them."}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_supabase_lockdown", "label": "Supabase Phase 1 lockdown", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only schema/grants/policies and session counts are saved before migrating; lockdown, hash backfill, account status, api_refresh_tokens, cleanup and advisor fixes are applied, but 003_drop_plaintext_token is prepared and not run until grants, policies and all original sessions are verified."}, {"id": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_path_routing", "label": "Path-based /api/ routing for all frontends", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Account, Home, Tools and legacy Edu move to path-based endpoints behind a failing integration test first; Home redirects straight to the central me.php instead of running a parallel issuer, so there is exactly one session authority."}], "edges": [{"source": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_same_origin_sso_plan", "target": "docs_office_decisions", "relation": "references", "confidence": "AMBIGUOUS", "confidence_score": 0.2, "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "weight": 0.2}, {"source": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_same_origin_sso_plan", "target": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_central_opaque_session", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_same_origin_sso_plan", "target": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_shared_auth_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_same_origin_sso_plan", "target": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_xss_regression_gate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_same_origin_sso_plan", "target": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_fail_closed_markdown_renderer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-08-05-vevit-sso-implementation.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_same_origin_sso_plan", "target": "docs_superpowers_plans_2026_08_05_vevit_sso_implementation_edu_sanitiz