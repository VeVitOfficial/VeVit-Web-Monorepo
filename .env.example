# Public site URL. Do not add server secrets to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=https://www.vevit.cz

# Server-only Supabase Data API access used by Next.js Route Handlers and ISR.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-component-key

# Optional overrides for existing Supabase Edge Functions. When omitted, the
# standard /functions/v1/<name> URLs are derived safely from SUPABASE_URL.
SUPABASE_AUTH_FUNCTION_URL=https://your-project.supabase.co/functions/v1/auth
SUPABASE_API_FUNCTION_URL=https://your-project.supabase.co/functions/v1/api
SUPABASE_STRIPE_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/stripe-webhook

# Optional shared token checked by your Edge Function before accepting BFF requests.
VEVIT_EDGE_PROXY_SECRET=

# Stripe stays server-side. Prefer the existing Supabase stripe functions/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional BIN lookup for banks missing from the local table. URL template with {bin},
# e.g. https://lookup.binlist.net/{bin}. Only the first 6-8 card digits are ever sent.
BIN_LOOKUP_URL=
BIN_LOOKUP_API_KEY=

# Stripe publishable key (test: pk_test_...). Safe to expose to the browser; card details are
# sent straight from the browser to Stripe with it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Packeta (Zásilkovna). The widget key is public (test account key for development). The API password
# and the sender label stay server-side: the password creates packets, the label names the sender.
NEXT_PUBLIC_PACKETA_API_KEY=
PACKETA_API_PASSWORD=
PACKETA_SENDER_LABEL=

# Secret for the job runner (GET /api/jobs/run, called by Vercel Cron with "Authorization: Bearer <value>").
# Vercel sends it automatically when a CRON_SECRET project variable exists. Use a long random value.
CRON_SECRET=

# Optional: carrier hosts allowed in tracking links (code -> https origin), e.g.
# {"packeta":"https://tracking.packeta.com"}. Links to other hosts are hidden from customers.
TRACKING_CARRIER_ORIGINS_JSON=
