{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://vevit.cz/schemas/aifb-content.schema.json",
 "title": "AIFB – obsah kategorie (aifb-content-*.json)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "version",
  "language",
  "category",
  "guide",
  "levels"
 ],
 "properties": {
  "schemaVersion": {
   "const": "1.0"
  },
  "version": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}$"
  },
  "language": {
   "const": "cs"
  },
  "category": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "title",
    "subtitle",
    "grades",
    "unit",
    "theme",
    "usageMode",
    "audience",
    "source"
   ],
   "properties": {
    "id": {
     "enum": [
      "zs1",
      "zs2",
      "ss"
     ]
    },
    "title": {
     "type": "string"
    },
    "subtitle": {
     "type": "string"
    },
    "grades": {
     "type": "string"
    },
    "unit": {
     "enum": [
      "Blok",
      "Level"
     ]
    },
    "theme": {
     "enum": [
      "pirate-map",
      "trail",
      "clean"
     ]
    },
    "usageMode": {
     "enum": [
      "teacher-led",
      "teacher-led-then-individual",
      "individual"
     ]
    },
    "audience": {
     "type": "string"
    },
    "source": {
     "type": "object",
     "required": [
      "document",
      "note"
     ],
     "properties": {
      "document": {
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     }
    }
   }
  },
  "guide": {
   "type": "array",
   "description": "Kapitoly pro učitele (úvod, pravidla, ochrana údajů, doporučený postup). Čísla kapitol se zobrazují, protože se na ně text odkazuje (např. „oddíl 7.2“).",
   "items": {
    "$ref": "#/$defs/guideChapter"
   }
  },
  "levels": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/level"
   }
  }
 },
 "$defs": {
  "md": {
   "type": "string",
   "description": "Text s lehkým Markdownem: pouze **tučně** a *kurzíva*. Neoddělitelné mezery (U+00A0) za jednoznakovými předložkami zachovat."
  },
  "block": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "type",
      "text"
     ],
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "p"
      },
      "text": {
       "$ref": "#/$defs/md"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "type",
      "text"
     ],
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "heading"
      },
      "text": {
       "type": "string"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "type",
      "ordered",
      "items"
     ],
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "list"
      },
      "ordered": {
       "type": "boolean"
      },
      "title": {
       "type": "string"
      },
      "items": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/md"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "type",
      "caption",
      "header",
      "rows"
     ],
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "table"
      },
      "caption": {
       "type": "string"
      },
      "header": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "rows": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "type",
      "title",
      "paras"
     ],
     "additionalProperties": false,
     "properties": {
      "type": {
       "const": "callout"
      },
      "title": {
       "type": "string"
      },
      "paras": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/md"
       }
      }
     }
    }
   ]
  },
  "guideSection": {
   "type": "object",
   "required": [
    "number",
    "id",
    "title",
    "blocks"
   ],
   "additionalProperties": false,
   "properties": {
    "number": {
     "type": "string"
    },
    "id": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "blocks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/block"
     }
    }
   }
  },
  "guideChapter": {
   "type": "object",
   "required": [
    "number",
    "id",
    "title",
    "blocks"
   ],
   "additionalProperties": false,
   "properties": {
    "number": {
     "type": "string"
    },
    "id": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "blocks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/block"
     }
    },
    "sections": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/guideSection"
     }
    }
   }
  },
  "pupil": {
   "type": "object",
   "required": [
    "status"
   ],
   "additionalProperties": false,
   "description": "Vrstva pro žáky. V plánech pro učitele žádný text pro žáky není, proto je výchozí stav todo.",
   "properties": {
    "status": {
     "enum": [
      "todo",
      "draft",
      "reviewed",
      "published"
     ]
    },
    "text": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/md"
     }
    },
    "interactive": {
     "type": "object",
     "required": [
      "component"
     ],
     "properties": {
      "component": {
       "type": "string"
      },
      "config": {
       "type": "object"
      }
     }
    }
   }
  },
  "lesson": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "id",
      "type",
      "order",
      "title",
      "teacher",
      "pupil"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "type": {
       "const": "theory"
      },
      "order": {
       "const": 0
      },
      "title": {
       "type": "string"
      },
      "teacher": {
       "type": "object",
       "required": [
        "intro",
        "reviewQuestions",
        "discussionTopics"
       ],
       "additionalProperties": false,
       "properties": {
        "intro": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/md"
         }
        },
        "reviewQuestions": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/md"
         }
        },
        "discussionTopics": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/md"
         }
        }
       }
      },
      "pupil": {
       "$ref": "#/$defs/pupil"
      }
     }
    },
    {
     "type": "object",
     "required": [
      "id",
      "type",
      "order",
      "title",
      "teacher",
      "pupil"
     ],
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "type": {
       "const": "exercise"
      },
      "order": {
       "type": "integer",
       "minimum": 1,
       "maximum": 5
      },
      "title": {
       "type": "string"
      },
      "teacher": {
       "type": "object",
       "required": [
        "description",
        "expectedOutput",
        "form",
        "time"
       ],
       "additionalProperties": false,
       "properties": {
        "description": {
         "type": "array",
         "items": {
          "$ref": "#/$defs/md"
         }
        },
        "expectedOutput": {
         "$ref": "#/$defs/md"
        },
        "form": {
         "$ref": "#/$defs/md"
        },
        "time": {
         "type": "string"
        }
       }
      },
      "pupil": {
       "$ref": "#/$defs/pupil"
      }
     }
    }
   ]
  },
  "level": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "order",
    "code",
    "title",
    "unitLabel",
    "intro",
    "goals",
    "hours",
    "schedule",
    "scheduleNote",
    "lessons",
    "lessonCount",
    "teacherNotes",
    "themes",
    "status",
    "certification"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "order": {
     "type": "integer"
    },
    "code": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "subtitle": {
     "type": "string"
    },
    "unitLabel": {
     "enum": [
      "Blok",
      "Level"
     ]
    },
    "grades": {
     "type": "string"
    },
    "recommendedPlacement": {
     "type": "string"
    },
    "derivedFrom": {
     "type": "string"
    },
    "themes": {
     "type": "string"
    },
    "intro": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/md"
     }
    },
    "goals": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/md"
     }
    },
    "hours": {
     "type": "string"
    },
    "hoursNote": {
     "type": "string"
    },
    "schedule": {
     "type": "object",
     "required": [
      "header",
      "rows"
     ],
     "properties": {
      "header": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "rows": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    "scheduleNote": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/md"
     }
    },
    "lessons": {
     "type": "array",
     "minItems": 6,
     "maxItems": 6,
     "items": {
      "$ref": "#/$defs/lesson"
     }
    },
    "lessonCount": {
     "type": "integer"
    },
    "teacherNotes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/md"
     }
    },
    "status": {
     "enum": [
      "content-ready"
     ]
    },
    "certification": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "name",
        "status"
       ],
       "properties": {
        "name": {
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "const": "planned"
        }
       }
      }
     ]
    },
    "visual": {
     "type": "object",
     "description": "Návrh vizuálu pro téma pirate-map (x, y v % plochy mapy).",
     "properties": {
      "islandName": {
       "type": "string"
      },
      "icon": {
       "type": "string"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      },
      "hint": {
       "type": "string"
      },
      "proposal": {
       "type": "boolean"
      }
     }
    }
   }
  }
 }
}